    text-decoration-color: var(--color-pink);
  }

  .fish {
    position: absolute;
    z-index: 1;
    color: var(--color-blue);
    pointer-events: none;
  }

  .fish pre {
    margin: 0;
    font: inherit;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .fish--one { top: 6%; right: 2%; }
  .fish--two { top: 48%; left: 2%; color: var(--color-pink); }
  .fish--three { right: 6%; bottom: 1%; color: var(--color-cyan); }

  .work-index {
    display: grid;
    gap: var(--space-lg);
    margin-top: var(--space-xl);
    padding: var(--space-lg) 0;
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .work-index-label { margin: 0; text-transform: uppercase; }

  .work-index-group {
    display: grid;
    align-content: start;
    gap: var(--space-xs);
  }

  .work-index-group a {
    width: fit-content;
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .index-tab {
    margin-bottom: var(--space-xs);
    padding: 0 var(--space-sm);
    text-transform: uppercase;
  }

  .index-tab--lime { background: var(--color-lime); }
  .index-tab--cyan { background: var(--color-cyan); }
  .index-tab--blue { background: var(--color-powder); }

  .featured-section,
  .studio-section,
  .about-section { padding-top: var(--space-section); }

  .section-heading,
  .studio-heading { margin-bottom: var(--space-xl); }

  .section-heading p,
  .studio-heading > p,
  .featured-label,
  .about-label {
    margin: 0 0 var(--space-sm);
    text-transform: uppercase;
  }

  .section-heading h2,
  .studio-heading h2 {
    max-width: 12ch;
    margin: 0;
    font-size: var(--text-section);
    font-weight: 850;
    line-height: var(--leading-flat);
    text-transform: uppercase;
  }

  .featured-collage {
    position: relative;
    display: grid;
    gap: var(--space-xl);
  }

  .featured-main {
    display: block;
    padding: var(--space-md);
    background: var(--color-cyan);
    box-shadow: var(--shadow-paper);
    transform: rotate(-1deg);
  }

  .featured-main img,
  .featured-process img,
  .project-piece > a img {
    display: block;
    width: 100%;
    height: auto;
  }

  .featured-note {
    position: relative;
    z-index: 3;
    max-width: var(--max-width-note);
    padding: var(--space-xl);
    background: var(--color-pink);
    box-shadow: var(--shadow-paper);
    transform: rotate(1.5deg);
  }

  .featured-tape {
    top: calc(var(--space-lg) * -1);
    right: var(--space-xl);
    width: 34%;
    transform: rotate(-4deg);
  }

  .featured-summary {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .featured-facts {
    display: grid;
    gap: var(--space-md);
    margin: var(--space-lg) 0;
  }

  .featured-facts div {
    display: grid;
    gap: var(--space-2xs);
  }

  .featured-facts dt {
    font-size: var(--text-sm);
    text-transform: uppercase;
  }

  .featured-facts dd { margin: 0; }

  .featured-process {
    margin: 0;
    padding: var(--space-md);
    background: var(--color-lime);
    box-shadow: var(--shadow-paper);
    transform: rotate(-2deg);
  }

  .featured-process figcaption { margin-top: var(--space-sm); font-size: var(--text-sm); }
  .studio-heading h2 { max-width: 16ch; }

  .project-collage {
    display: grid;
    gap: var(--space-2xl);
  }

  .project-piece {
    display: grid;
    align-items: start;
  }

  .project-piece > a {
    display: block;
    overflow: hidden;
    background: var(--color-ink);
    box-shadow: var(--shadow-paper);
  }

  .project-piece > a img { transition: transform var(--motion-duration-image) var(--motion-ease-out); }

  .project-piece > a:hover img,
  .project-piece > a:focus-visible img { transform: scale(var(--motion-scale-image)); }

  .project-caption {
    position: relative;
    z-index: 2;
    width: 88%;
    margin-top: calc(var(--space-lg) * -1);
    padding: var(--space-lg);
    box-shadow: var(--shadow-paper);
  }

  .project-caption--pink { margin-left: auto; background: var(--color-pink); transform: translateX(calc(var(--space-sm) * -1)) rotate(1deg); }
  .project-caption--lime { background: var(--color-lime); transform: translateX(var(--space-sm)) rotate(-2deg); }
  .project-caption--cyan { margin-left: auto; background: var(--color-cyan); transform: translateX(calc(var(--space-sm) * -1)) rotate(2deg); }
  .project-caption--blue { background: var(--color-powder); transform: translateX(var(--space-sm)) rotate(-1deg); }

