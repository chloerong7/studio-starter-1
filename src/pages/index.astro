import limelightPoster from '../assets/projects/graphics/limelight-poster.png';
import sketchesCard from '../assets/projects/product-sketches/card.jpg';

/*
  THESIS: Home behaves like Chloe's open sketchbook on a bright browser canvas, not a conventional portfolio grid.
  OWN-WORLD: Flat pink, lime, cyan, and powder-blue papers; solid cut edges; soft physical shadows; Gabarito display type; Courier Prime notes; small tape and ASCII fish.
  STORY: Meet Chloe, deliberately explore her work categories, see POYjector as the lead product-design proof, then discover games, graphics, sketches, and a way to connect.
  FIRST VIEWPORT: A taped pink identity paper balances a movable three-paper work stack; the compact work index anchors the lower edge.
  FORM: Airy interactive collage, approved in experiment-c1d-flat-color.png, extended into an editorial project scroll with responsive stacking.
*/
