      <p>I’m deeply inspired by the internet, printed media, movies, and games. I place the people a design is made for at the center—and leave room for play.</p>
      <a href="/about/">More about Chloe →</a>
    </div>
    <pre class="about-fish" aria-hidden="true">      ,,&#10;   &lt;(' )&#10;     ``</pre>
  </section>

  <script>
    const movablePapers = document.querySelectorAll<HTMLElement>('[data-draggable]');
    const desktopLayout = window.matchMedia('(min-width: 48rem)');
    const resetPapers: Array<() => void> = [];

    movablePapers.forEach((paper) => {
      let originX = 0;
      let originY = 0;
      let offsetX = 0;
      let offsetY = 0;
      let dragging = false;

      const renderPosition = () => {
        paper.style.setProperty('--drag-x', `${offsetX}px`);
        paper.style.setProperty('--drag-y', `${offsetY}px`);
      };

      const constrainPosition = (nextX: number, nextY: number) => {
        const homeHero = paper.closest<HTMLElement>('.home-hero');
        if (!desktopLayout.matches || !homeHero) return { x: nextX, y: nextY };

        const boundaryRect = homeHero.getBoundingClientRect();
        const paperRect = paper.getBoundingClientRect();
        const baseLeft = paperRect.left - offsetX;
        const baseTop = paperRect.top - offsetY;

        return {
          x: Math.min(boundaryRect.right - baseLeft - paperRect.width, Math.max(boundaryRect.left - baseLeft, nextX)),
          y: Math.min(boundaryRect.bottom - baseTop - paperRect.height, Math.max(boundaryRect.top - baseTop, nextY)),
        };
      };

      paper.addEventListener('pointerdown', (event) => {
        if (event.target instanceof Element && event.target.closest('a')) return;
        dragging = true;
        originX = event.clientX - offsetX;
        originY = event.clientY - offsetY;
        paper.setPointerCapture(event.pointerId);
        paper.dataset.dragging = 'true';
      });

      paper.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const nextPosition = constrainPosition(event.clientX - originX, event.clientY - originY);
        offsetX = nextPosition.x;
        offsetY = nextPosition.y;
        renderPosition();
      });

      const stopDragging = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        paper.releasePointerCapture(event.pointerId);
        delete paper.dataset.dragging;
      };

      paper.addEventListener('pointerup', stopDragging);
      paper.addEventListener('pointercancel', stopDragging);

      paper.addEventListener('keydown', (event) => {
        const step = 12;
        let nextX = offsetX;
        let nextY = offsetY;
        if (event.key === 'ArrowLeft') nextX -= step;
        else if (event.key === 'ArrowRight') nextX += step;
        else if (event.key === 'ArrowUp') nextY -= step;
        else if (event.key === 'ArrowDown') nextY += step;
        else return;

        event.preventDefault();
        const nextPosition = constrainPosition(nextX, nextY);
        offsetX = nextPosition.x;
        offsetY = nextPosition.y;
        renderPosition();
      });

      resetPapers.push(() => {
        offsetX = 0;
        offsetY = 0;
        renderPosition();
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      resetPapers.forEach((resetPaper) => resetPaper());
    });
  </script>
</Base>

<style>
  .home-hero,
  .featured-section,
  .studio-section,
  .about-section {
    width: min(100%, var(--max-width-hero));
    margin: 0 auto;
    padding-right: var(--space-md);
    padding-left: var(--space-md);
  }

  .home-hero { padding-top: var(--space-xl); }

  .hero-stage {
    position: relative;
    display: grid;
    gap: var(--space-xl);
    align-items: center;
    min-height: calc(var(--space-3xl) * 5);
  }

  .identity-paper {
    position: relative;
    z-index: 3;
    max-width: var(--max-width-identity);
    padding: var(--space-xl) var(--space-lg);
    color: var(--color-ink);
    background: var(--color-pink);
    box-shadow: var(--shadow-paper);
    transform: rotate(-1.5deg);
  }

  .identity-tape,
  .featured-tape {
    position: absolute;
    z-index: 2;
    display: block;
    height: var(--space-xl);
    background: color-mix(in srgb, var(--color-tape) 76%, transparent);
  }

  .identity-tape {
    top: calc(var(--space-md) * -1);
    left: calc(var(--space-md) * -1);
    width: 25%;
    transform: rotate(-12deg);
  }

  .identity-paper h1 {
    margin: 0;
    font-size: var(--text-identity);
    font-weight: 850;
    line-height: var(--leading-flat);
    white-space: nowrap;
    text-transform: uppercase;
  }

  .identity-rule {
    display: block;
    width: 100%;
    height: 1px;
    margin: var(--space-lg) 0;
    background: var(--color-ink);
  }

  .identity-paper p {
    max-width: 25ch;
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }

  .work-stack {
    position: relative;
    min-height: calc(var(--space-3xl) * 4.5);
  }

  .work-stack-heading { margin-bottom: var(--space-lg); }

  .work-stack-heading h2,
  .work-stack-heading p {
    margin: 0;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 400;
  }

  .work-stack-heading h2 { text-transform: uppercase; }

  .work-stack-heading p {
    margin-top: var(--space-xs);
    color: var(--color-text-secondary);
  }

  .work-paper {
    --drag-x: 0;
    --drag-y: 0;
    position: absolute;
    z-index: 2;
    width: 64%;
    min-height: calc(var(--space-3xl) * 1.55);
    padding: var(--space-xl) var(--space-lg);
    box-shadow: var(--shadow-paper);
    touch-action: none;
    cursor: grab;
    transform: translate(var(--drag-x), var(--drag-y)) rotate(var(--paper-rotation));
    transition: box-shadow var(--motion-duration-fast) var(--motion-ease-out);
  }

  .work-paper:focus-visible { outline-color: var(--color-ink); }

  .work-paper:hover,
  .work-paper:focus-visible,
  .work-paper[data-dragging="true"] {
    z-index: 8;
    box-shadow: var(--shadow-paper-hover);
  }

  .work-paper[data-dragging="true"] { cursor: grabbing; }

  .work-paper--product {
    --paper-rotation: 4deg;
    top: 12%;
    right: 4%;
    background: var(--color-lime);
  }

  .work-paper--games {
    --paper-rotation: -3deg;
    top: 36%;
    right: 22%;
    background: var(--color-cyan);
  }

  .work-paper--art {
    --paper-rotation: 3deg;
    right: 8%;
    bottom: 2%;
    background: var(--color-powder);
  }

  .work-paper-title {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 750;
    line-height: var(--leading-tight);
    text-decoration: none;
    text-transform: uppercase;
  }

  .project-slips {
    position: absolute;
    top: 48%;
    right: calc(var(--space-md) * -1);
    display: grid;
    width: 52%;
    gap: var(--space-xs);
  }

  .project-slips a {
    display: block;
    padding: var(--space-sm) var(--space-md);
    color: var(--color-ink);
    font-size: var(--text-sm);
    line-height: var(--leading-tight);
    text-decoration: none;
    text-transform: uppercase;
    background: var(--color-paper);
    box-shadow: var(--shadow-paper);
    transform: rotate(-4deg);
