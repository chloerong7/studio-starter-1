---
import '../styles/tokens.css';
import '../styles/global.css';

const {
  title = 'Chloe Rong — Portfolio',
  description = 'Chloe Rong is a designer focused on people, stories, and human connection.',
  bodyClass = '',
  showFooter = true,
  contactHref = '/#contact',
} = Astro.props;

const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <nav class="site-nav" aria-label="Main">
        <a href="/" class="nav-name">Chloe Rong</a>
        <div class="nav-links">
          <a href="/" aria-current={pathname === '/' ? 'page' : undefined}>Home</a>
          <a href="/work/" aria-current={pathname.startsWith('/work') ? 'page' : undefined}>Work</a>
          <a href="/about/" aria-current={pathname === '/about/' ? 'page' : undefined}>About</a>
          <a href={contactHref}>Contact</a>
        </div>
      </nav>
    </header>
    <main id="main" class="page">
      <slot />
    </main>
    {showFooter && (
      <footer id="contact" class="site-footer">
        <div class="footer-note">
          <span class="footer-tape" aria-hidden="true"></span>
          <p class="footer-kicker">Have a project, role, or idea?</p>
          <h2>Let’s make something people remember.</h2>
          <div class="footer-links">
            <a href="https://www.instagram.com/poysoyo/" target="_blank" rel="noreferrer">Instagram ↗</a>
            <a href="https://www.poysoyo.com/" target="_blank" rel="noreferrer">Current portfolio ↗</a>
          </div>
        </div>
        <div class="footer-meta">
          <p>&copy; 2026 Chloe Rong</p>
          <p>Designed for people, stories, and human connection.</p>
          <pre class="footer-fish" aria-hidden="true">o-   &lt;&gt;&lt;</pre>
        </div>
      </footer>
    )}
  </body>
</html>
